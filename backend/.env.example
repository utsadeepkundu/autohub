# AutoHub Django backend - local development template
# Copy this file to .env and replace the placeholder values.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Atlas connection string and database name.
MONGODB_URI=
MONGODB_NAME=autohub_db

# Local Vite development origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional in local development. Leave commented to use Django's local-memory cache.
# If using the existing WSL Redis service, uncomment this:
# REDIS_URL=redis://127.0.0.1:6379/1

# Email defaults to Django's console backend while DEBUG=True.
# Configure SMTP explicitly when deploying to production.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=AutoHub <noreply@example.com>

# Keep HSTS disabled until production HTTPS is configured and verified.
SECURE_HSTS_SECONDS=0
USE_X_FORWARDED_PROTO=False
