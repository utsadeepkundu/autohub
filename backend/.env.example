# ==========================================
# AUTOHUB BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Django
DJANGO_SECRET_KEY=replace-with-your-own-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/
MONGODB_NAME=autohub_db

# ==========================================
# FRONTEND AND CORS
# ==========================================

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CORS_ALLOW_CREDENTIALS=False

# ==========================================
# REDIS
# ==========================================

# Leave blank for local development.
REDIS_URL=

CACHE_KEY_PREFIX=autohub

# Production example:
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:PORT/0

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

# Automatically selects console locally and SMTP in production.
# Set EMAIL_BACKEND only when explicitly overriding this behaviour.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

DEFAULT_FROM_EMAIL=AutoHub <noreply@yourdomain.com>

# ==========================================
# PRODUCTION SECURITY
# ==========================================

# Enable these only after production HTTPS is configured.

# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=3600

# Production domains:
# ALLOWED_HOSTS=api.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
